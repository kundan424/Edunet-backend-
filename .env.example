# Database Configuration
DB_HOST=<SET_VALUE>
DB_PORT=<SET_VALUE>
DB_NAME=<SET_VALUE>
DB_USERNAME=<SET_VALUE>
DB_PASSWORD=<SET_VALUE>

# JWT Configuration
JWT_SECRET=<SET_VALUE>

# Stripe Configuration
STRIPE_SECRET_KEY=<SET_VALUE>
