# CORS origins e.g. https://yourdomain.com
EDTECH_CORS_ALLOWED_ORIGINS=<SET_VALUE>

# Port
PORT=<SET_VALUE>

# B2 Storage Configuration
B2_ENDPOINT=<SET_VALUE>
B2_BUCKET=<SET_VALUE>
B2_ACCESS_KEY=<SET_VALUE>
B2_SECRET_KEY=<SET_VALUE>
B2_REGION=<SET_VALUE>

# Media Storage Type (LOCAL or B2)
MEDIA_STORAGE_TYPE=<SET_VALUE>

# Email Configuration
EMAIL_PROVIDER=<SET_VALUE>
RESEND_API_KEY=<SET_VALUE>
EMAIL_FROM=<SET_VALUE>
