# Database Configuration
DB_HOST=<SET_VALUE>
DB_PORT=<SET_VALUE>
DB_NAME=<SET_VALUE>
DB_USERNAME=<SET_VALUE>
DB_PASSWORD=<SET_VALUE>

# JWT Configuration
JWT_SECRET=<SET_VALUE>

# Stripe Configuration
STRIPE_SECRET_KEY=<SET_VALUE>
STRIPE_WEBHOOK_SECRET=<SET_VALUE>

# CORS origins e.g. https://yourdomain.com
EDTECH_CORS_ALLOWED_ORIGINS=<SET_VALUE>

# Port
PORT=<SET_VALUE>

# R2 Storage Configuration
R2_ENDPOINT=<SET_VALUE>
R2_BUCKET=<SET_VALUE>
R2_ACCESS_KEY=<SET_VALUE>
R2_SECRET_KEY=<SET_VALUE>
R2_REGION=<SET_VALUE>

# Media Storage Type (LOCAL or R2)
MEDIA_STORAGE_TYPE=<SET_VALUE>

# Email Configuration
EMAIL_HOST=<SET_VALUE>
EMAIL_PORT=<SET_VALUE>
EMAIL_USERNAME=<SET_VALUE>
EMAIL_PASSWORD=<SET_VALUE>
EMAIL_FROM=<SET_VALUE>
